---
import '../styles/global.css';
import '../styles/pointer.css';
interface Props { title?: string; }
const { title = 'Sandratra — Ingénieur logiciel · Fullstack TypeScript & IA' } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sandratra, ingénieur logiciel depuis 2018. React, Next.js, TypeScript, API REST et GraphQL. Développement assisté par IA et application d’orchestration d’IA." />
    <meta name="theme-color" content="#0b1919" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Des interfaces React et Next.js aux API métier : découvrez mes réalisations fullstack et mon projet d’application d’orchestration d’IA." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico?v=straw-hat-2" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=straw-hat-2" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=straw-hat-2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:wght@400;450;500;550;600;650;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/images/grand-line.webp" />
    <title>{title}</title>
  </head>
  <body><a href="#main" class="skip-link">Aller au contenu</a><slot /><div id="water-effects" class="water-effects" aria-hidden="true"></div></body>
</html>
