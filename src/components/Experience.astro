---
import { experiences } from '../data/portfolio';
import Icon from './Icon.astro';
const highlights = [
  { ...experiences[1], index: '01', category: 'MARKETING LOCAL & SEO', title: ['Faire rayonner', 'chaque adresse.'], style: 'dilypse', sign: 'd.' },
  { ...experiences[2], index: '02', category: 'FORMATION PROFESSIONNELLE', title: ['Ouvrir le champ', 'des possibles.'], style: 'optedif', sign: 'o' },
  { ...experiences[0], index: '03', category: 'REFONTE & EXPÉRIENCE WEB', title: ['Un nouveau regard.', 'Une nouvelle expérience.'], style: 'sgel', sign: 'S' },
];
---
<section id="experience" class="section experience-section">
  <div class="container">
    <div class="section-heading reveal"><div><p class="eyebrow"><span>02</span> LES EXPÉDITIONS</p><h2>Chaque projet,<br /><em>une nouvelle île.</em></h2></div><p>Des défis réels. Des équipes passionnées.<br />Et toujours la même envie de bien faire.</p></div>
    <div class="project-grid">
      {highlights.map(project => (
        <article class="project-card reveal">
          <a href={`#mission-${project.style}`} class={`project-art ${project.style}`} aria-label={`Découvrir ma mission chez ${project.company}`}>
            <span class="project-art-top"><span>{project.category}</span><span>EXP. {project.index}</span></span>
            <span class="project-art-title">{project.title.map(line => <span>{line}</span>)}</span>
            <span class="project-sculpture" aria-hidden="true">{project.sign}</span>
            <span class="project-art-bottom">{project.company}<span class="project-open"><Icon name="diagonal" /></span></span>
          </a>
          <div class="project-info"><div><h3>{project.company}</h3><p>{project.role}</p></div><span class="project-year">{project.period.split(' — ')[0]}</span></div>
          <div class="tags">{project.stack.slice(0, 3).map(tech => <span>{tech}</span>)}</div>
        </article>
      ))}
    </div>
    <div class="journey-heading reveal"><span class="eyebrow">LE CARNET DE BORD</span><span>10 escales, depuis 2018</span></div>
    <div class="journey-list">
      {experiences.slice(0, 3).map((exp, index) => (
        <details class="journey-item" id={`mission-${['sgel', 'dilypse', 'optedif'][index]}`}>
          <summary><span class="journey-date">{exp.period}</span><span class="journey-company">{exp.company}<small>{exp.role}</small></span><span class="journey-status"><span class="status-dot"></span> En cours</span><span class="detail-plus" aria-hidden="true">+</span></summary>
          <div class="journey-content"><p>{exp.description}</p><div class="journey-meta"><span>{exp.location}</span>{exp.website && <a href={exp.website} target="_blank" rel="noopener noreferrer">Visiter le site <Icon name="diagonal" /></a>}</div><div class="tags">{exp.stack.map(tech => <span>{tech}</span>)}</div></div>
        </details>
      ))}
      <div id="earlier-journey" hidden>
        {experiences.slice(3).map(exp => <details class="journey-item"><summary><span class="journey-date">{exp.period}</span><span class="journey-company">{exp.company}<small>{exp.role}</small></span><span class="journey-status">Expédition terminée</span><span class="detail-plus" aria-hidden="true">+</span></summary><div class="journey-content"><p>{exp.description}</p><div class="journey-meta"><span>{exp.location}</span>{exp.website && <a href={exp.website} target="_blank" rel="noopener noreferrer">Visiter le site <Icon name="diagonal" /></a>}</div><div class="tags">{exp.stack.map(tech => <span>{tech}</span>)}</div></div></details>)}
      </div>
    </div>
    <button class="journey-toggle text-link" id="journey-toggle" aria-expanded="false" aria-controls="earlier-journey"><span>Voir les 7 premières escales</span><span class="toggle-sign" aria-hidden="true">+</span></button>
    <noscript><style>#earlier-journey[hidden]{display:block!important}#journey-toggle{display:none}</style></noscript>
  </div>
</section>
