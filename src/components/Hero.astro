---
import Icon from './Icon.astro';
import LogPose from './LogPose.astro';
---
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="hero-scene" aria-hidden="true"><img src="/images/grand-line.webp" alt="" width="1672" height="941" fetchpriority="high" /></div>
  <div class="hero-shade" aria-hidden="true"></div><div class="hero-grain" aria-hidden="true"></div>
  <div class="container hero-content">
    <div class="hero-eyebrow"><span class="short-line"></span> UN ESPRIT LIBRE. UN CODE PRÉCIS.</div>
    <p class="hero-intro">Hello, moi c’est <strong>Sandratra</strong><span class="small-star">✧</span></p>
    <h1 id="hero-title">Le code pour cap.<br />L’aventure pour<br /><em>horizon.</em></h1>
    <p class="hero-description"><strong>Ingénieur logiciel · Fullstack TypeScript</strong><span class="hero-specialty">Développement web & orchestration d’IA.</span> Des interfaces React / Next.js aux API :<br class="desktop-break" /> je construis les outils qui font avancer votre activité.</p>
    <div class="hero-actions">
      <a class="button button-gold" href="#experience">Explorer mes expéditions <Icon /></a>
      <a class="text-link" href="#about">Rencontrer le capitaine <Icon name="diagonal" /></a>
    </div>
    <div class="hero-availability"><span class="status-dot"></span> Prêt à embarquer pour de nouveaux projets</div>
  </div>
  <div class="hero-coordinate"><span class="coordinate-cross">+</span><span>CAP SUR GRAND LINE<small>ANTANANARIVO, MADAGASCAR</small></span></div>
  <div class="ship-caption"><span class="caption-rule"></span> L’AVENTURE N’ATTEND PAS.</div>
  <LogPose />
  <div class="container hero-bottom">
    <a href="#about" class="scroll-link"><span class="scroll-capsule">↓</span> LE VOYAGE COMMENCE ICI</a>
    <span class="hero-edition">PORTFOLIO VOL. 01 <span>—</span> EST. 2018</span>
    <button id="motion-toggle" class="motion-toggle" aria-pressed="false" aria-label="Réduire les animations"><span class="motion-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span id="motion-label">MOUVEMENT ON</span></button>
  </div>
</section>
<div class="tech-ribbon" aria-label="Technologies et outils IA">
  <div class="container ribbon-inner">
    <span class="ribbon-label">MES COMPAGNONS<br />D’AVENTURE</span>
    <span class="tech-word react-word"><span aria-hidden="true">⚛</span> React</span>
    <span class="tech-word next-word"><span class="companion-icon" style="--companion-icon: url('/icons/nextjs.svg')" aria-hidden="true"></span>NEXT<span class="tech-suffix">.js</span></span>
    <span class="tech-word node-word"><span class="companion-icon" style="--companion-icon: url('/icons/nodejs.svg')" aria-hidden="true"></span>node<span class="tech-suffix">.js</span></span>
    <div class="ribbon-ai">
      <span class="tech-word ai-word"><span class="companion-icon" style="--companion-icon: url('/icons/codex.svg')" aria-hidden="true"></span>Codex / GPT</span>
      <span class="tech-word ai-word claude-word"><span class="companion-icon" style="--companion-icon: url('/icons/claude.svg')" aria-hidden="true"></span>Claude</span>
      <span class="tech-word ai-word"><span class="companion-icon" style="--companion-icon: url('/icons/cursor.svg')" aria-hidden="true"></span>Cursor</span>
    </div>
  </div>
</div>
