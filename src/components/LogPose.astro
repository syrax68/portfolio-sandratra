<a href="#experience" class="log-pose-link" aria-label="Suivre le Log Pose vers mes expéditions">
  <div class="log-pose" aria-hidden="true">
    <div class="compass-shadow"></div>
    <div class="compass-object">
      <div class="compass-loop"></div><div class="compass-base"></div>
      <div class="compass-face">
        <span class="compass-direction north">N</span><span class="compass-direction south">S</span><span class="compass-direction east">E</span><span class="compass-direction west">W</span>
        <div class="compass-rose"></div><div class="compass-needle"></div><div class="compass-pin"></div>
      </div>
      <div class="compass-glass"></div>
    </div>
  </div>
  <span class="log-pose-label"><span>LE LOG POSE</span><small>La prochaine aventure vous attend ↗</small></span>
</a>
