---
interface Props { name?: string; class?: string; }
const { name = 'arrow', class: className = '' } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M5 12h14M13 6l6 6-6 6', diagonal: 'M6 18 18 6M6 6h12v12',
  anchor: 'M12 7v14M8 11h8M4 14c0 9 16 9 16 0M1 17l3-3 3 3M17 17l3-3 3 3',
  compass: 'm12 3 3 6 6 3-6 3-3 6-3-6-6-3 6-3Z',
  code: 'm8 6-6 6 6 6M16 6l6 6-6 6M14 3l-4 18',
  layers: 'm12 3 10 5-10 5L2 8ZM2 12l10 5 10-5M2 16l10 5 10-5',
  globe: 'M21 12H3M12 3c-6 5-6 13 0 18M12 3c6 5 6 13 0 18',
  mail: 'M3 5h18v14H3ZM3 6l9 7 9-7', copy: 'M8 8h12v12H8ZM16 8V4H4v12h4', check: 'm5 12 4 4L19 6',
};
---
<svg class={className} width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'globe' && <circle cx="12" cy="12" r="9" />}
  {name === 'anchor' && <circle cx="12" cy="4" r="3" />}
  <path d={paths[name] || paths.arrow} />
</svg>
